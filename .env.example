# Reddit Pulse Environment Configuration
# Copy this file to .env and fill in your actual values

# Reddit API Configuration
# Get these from https://www.reddit.com/prefs/apps
VITE_REDDIT_CLIENT_ID=your_reddit_client_id_here
VITE_REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# OpenAI API Configuration (for sentiment analysis)
# Get your API key from https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Alternative: Use OpenRouter for multiple AI models
# Get your API key from https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Backend API Configuration (if using a separate backend)
VITE_API_BASE_URL=http://localhost:3001/api

# Application Configuration
VITE_APP_NAME=Reddit Pulse
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=development

# Feature Flags
VITE_ENABLE_REAL_REDDIT_API=false
VITE_ENABLE_SENTIMENT_ANALYSIS=true
VITE_ENABLE_TREND_ANALYSIS=true
VITE_ENABLE_EXPORT_FEATURES=true

# Analytics and Monitoring (optional)
VITE_GOOGLE_ANALYTICS_ID=your_ga_id_here
VITE_SENTRY_DSN=your_sentry_dsn_here

# Third-party Integrations (optional)
VITE_SLACK_WEBHOOK_URL=your_slack_webhook_url_here
VITE_DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Rate Limiting Configuration
VITE_REDDIT_RATE_LIMIT_REQUESTS_PER_MINUTE=60
VITE_OPENAI_RATE_LIMIT_REQUESTS_PER_MINUTE=20

# Cache Configuration
VITE_CACHE_DURATION_MINUTES=5
VITE_MAX_CACHE_SIZE_MB=50

# Development Configuration
VITE_DEBUG_MODE=true
VITE_MOCK_DATA_ENABLED=true
